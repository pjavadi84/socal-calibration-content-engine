{
  "name": "socal-calibration-content-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "supabase db push",
    "db:migrate:remote": "node_modules/.bin/dotenv -e .env.local -- sh -c 'for f in supabase/migrations/*.sql; do psql \"$SUPABASE_DB_URL\" -f \"$f\" || exit 1; done'",
    "db:seed": "node_modules/.bin/dotenv -e .env.local -- sh -c 'psql \"$SUPABASE_DB_URL\" -f supabase/seeds/seed.sql'",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --linked > src/lib/db/types.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@supabase/supabase-js": "^2.49.0",
    "@supabase/ssr": "^0.6.0",
    "inngest": "^3.31.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
