# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx
# Postgres connection string (Dashboard > Settings > Database > Connection string URI)
# Required for db:seed against remote
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Google Gemini
GEMINI_API_KEY=xxx
# Optional — default gemini-2.5-flash (2.0-flash is not available to new keys)
# GEMINI_MODEL=gemini-2.5-flash

# WordPress
WP_SITE_URL=https://socalcalibration.com
WP_USERNAME=xxx
WP_APP_PASSWORD=xxx

# Inngest
INNGEST_EVENT_KEY=xxx
INNGEST_SIGNING_KEY=xxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
